# Copy this file to .env and fill in your credentials. .env is git-ignored: never commit it.

# Telegram: bot token from @BotFather, plus the chat id that should receive alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Gemini: only used when [ai] enabled = true in config/settings.toml.
GEMINI_API_KEY=

# Zerodha Kite Connect (developers.kite.trade): used when [data] provider = "kite".
# Log in once per day with: python -m trader.data.kite login
KITE_API_KEY=
KITE_API_SECRET=

# Optional: a heartbeat URL from a dead man's switch service (e.g. healthchecks.io). It is pinged after
# every successful daily run; if the pings stop, that service alerts you, even when this PC is off.
HEARTBEAT_URL=
